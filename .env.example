# SMTP-Zugangsdaten (Plesk-Mailkonto)
SMTP_HOST=mail.ihre-domain.de
SMTP_PORT=587
SMTP_USER=noreply@ihre-domain.de
SMTP_PASSWORD=ihr_sicheres_passwort
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@ihre-domain.de

# Sicherheit: langen, zufälligen Schlüssel verwenden
# Generieren z.B. mit: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=HIER_EINEN_LANGEN_ZUFAELLIGEN_SCHLUESSEL_EINSETZEN

# Rate Limiting (Anfragen pro Zeiteinheit pro IP)
RATE_LIMIT=20/minute
